#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing required command: $1" >&2
    exit 1
  }
}

echo "==> checking prerequisites"
require_cmd git

echo "==> installing system dependencies"
"$ROOT_DIR/script/install-deps-ubuntu"

echo "==> checking required tools after dependency install"
require_cmd stow

echo "==> installing neovim"
"$ROOT_DIR/script/install-neovim"

echo "==> preparing ~/.bash directory"
# Pre-create as a real directory so stow links files individually
# instead of folding the whole thing into one directory-symlink
# pointing into the repo — that would put untracked files
# (bashrc.local, history) physically inside the repo tree.
mkdir -p ~/.bash

# Migrate any pre-existing bash history into the new location, once.
# Guarded so re-running this script never clobbers newer history.
if [ -f ~/.bash_history ] && [ ! -f ~/.bash/history ]; then
    cp ~/.bash_history ~/.bash/history
fi

# Seed the machine-local override file if it doesn't exist yet.
# Guarded so re-running this script never clobbers existing content.
if [ ! -f ~/.bash/bashrc.local ]; then
    cat > ~/.bash/bashrc.local <<'EOF'
# ~/.bash/bashrc.local — machine-specific overrides, NOT tracked in
# the dotfiles repo (see bash/.bash/.gitignore). Sourced automatically
# by ~/.bash/bashrc if present.
EOF
fi

echo "==> stowing dotfiles"
mv ~/.bashrc ~/.bashrc.default # preserve current bashrc if exists
"$ROOT_DIR/script/stow-dotfiles"

echo "==> sourcing ~/.bashrc"
source $HOME/.bashrc

echo "==> done"
