#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing required command: $1" >&2
    exit 1
  }
}

confirm_remove() {
  local target="$1"

  if [ -e "$target" ] || [ -L "$target" ]; then
    echo "warning: $target already exists"
    read -r -p "remove it and continue? [y/N] " reply
    case "$reply" in
      y|Y|yes|YES)
        rm -rf "$target"
        echo "removed $target"
        ;;
      *)
        echo "aborted"
        exit 1
        ;;
    esac
  fi
}

echo "==> checking prerequisites"
require_cmd git

echo "==> installing system dependencies"
"$ROOT_DIR/script/install-deps-ubuntu"

echo "==> checking required tools after dependency install"
require_cmd stow

confirm_remove "$HOME/.bashrc"

echo "==> installing neovim"
"$ROOT_DIR/script/install-neovim"

echo "==> stowing dotfiles"
"$ROOT_DIR/script/stow-dotfiles"

echo "==> installing shell tooling"
"$ROOT_DIR/script/install-shell-tools"

echo "==> installing tmux plugins"
"$ROOT_DIR/script/install-tmux-plugins"

echo "==> installing neovim plugins"
"$ROOT_DIR/script/install-nvim-plugins"

echo "==> done"
echo "You may need to restart your shell or run: exec zsh"
