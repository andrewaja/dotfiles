# ~/.zsh/nga-client -- for a machine (the Mac) that drives the NGA
# cluster's dev VMs from outside. zsh only. Stowed everywhere but only
# sourced where `script/bootstrap --nga-client` added it to
# ~/.zsh/zshrc.local. Needs an `ajamian-dev` entry in ~/.ssh/config and
# the Xpra app; see ~/research/agent-skills/docs/nga-vivado.md.

# Xpra client: the app ships no CLI on PATH; its bundle dir holds only the binary.
export PATH="$PATH:/Applications/Xpra.app/Contents/MacOS"

# Vivado GUI on ajamian-dev through xpra, one session per project:
#   vivado@ajamian-dev [-v <version>] -p <name>
# If that project's session is already running, just reattaches (and
# refuses if -v asks for a different version). Otherwise it looks in
# ~/research/projects/<name> on the VM for Vivado projects (.xpr): one is
# opened directly, several give a numbered list, none asks for a folder to
# open Vivado in (relative to the project; default its top level). Vivado
# runs in the .xpr's folder (or the chosen one), with its log, journal and
# temp dir pinned there by absolute path, so nothing lands in ~ even after
# a Tcl `cd`.
# A missing project is offered for creation: it asks for a build folder
# (default /shared/build/<name>), then lays out rtl/ sim/ bd/ constr/
# scripts/, a `build` link to the build folder, a .gitignore, and
# scripts/create_project.tcl, which Vivado runs at once to create the
# project in build/ from those folders. The folder becomes a git repo
# (branch main, no remote) with the layout as its first commit.
# -v picks an install on /shared/Xilinx (e.g. 2022.1); the default is the
# newest one there. Vivado starts from a clean shell with only that
# version's settings64.sh sourced, so the 2026.1 PATH from dotfiles
# --nga-dev can't leak into older versions. Sessions are named
# vivado-<name> and take the first free display from :100 up. Quit Vivado
# (File > Exit) before `xpra stop :<display>` on the VM; it aborts if its
# display disappears under it.
vivado@ajamian-dev() {
    local OPTIND=1 opt name= version= out reply sel workdir= xpr= display ver i
    local builddir= tcl=
    local -a xprs
    while getopts p:v: opt; do
        case $opt in
            p) name=$OPTARG ;;
            v) version=$OPTARG ;;
            *) name= ; break ;;
        esac
    done
    if [[ ! $name =~ '^[A-Za-z0-9._-]+$' || ( -n $version && ! $version =~ '^[0-9]{4}\.[0-9]+$' ) ]]; then
        echo "usage: vivado@ajamian-dev [-v <version>] -p <project>   (project: letters, digits, . _ -; version: e.g. 2022.1)" >&2
        return 2
    fi

    # On the VM: "running <display> <version>" if this project's session is
    # up, else "nodir" or one "xpr <path>" line per .xpr (path relative to
    # the project; none if there are none).
    out=$(ssh ajamian-dev bash -s -- ${(qq)name} ${(qq)version} <<'EOF'
name=$1 want=$2
dir=~/research/projects/$name
pid=$(pgrep -f -- "^/usr/bin/xpra start :[0-9]+ .*--session-name=vivado-$name( |\$)" | head -1)
if [ -n "$pid" ]; then
    cmd=$(tr '\0' ' ' < /proc/$pid/cmdline)
    d=$(printf '%s' "$cmd" | grep -oE 'start :[0-9]+' | cut -d: -f2)
    v=$(printf '%s' "$cmd" | grep -oE 'Xilinx/(Vivado/)?[0-9]{4}\.[0-9]+/' | head -1 | grep -oE '[0-9]{4}\.[0-9]+')
    if [ -n "$want" ] && [ "$want" != "${v:-unknown}" ]; then
        echo "vivado-$name is already running with Vivado ${v:-unknown} on :$d; quit it (File > Exit) to switch versions" >&2
        exit 1
    fi
    echo "running $d ${v:-unknown}"
    exit 0
fi
[ -d "$dir" ] || { echo nodir; exit 0; }
# -L: build trees may be symlinks into /shared/build (e.g. aved-v80/view).
cd "$dir" && find -L . \( -name .git -o -name .Xil \) -prune -o -name '*.xpr' -print | sed 's|^\./||' | sort | sed 's/^/xpr /'
EOF
    ) || return 1

    if [[ $out == running\ * ]]; then
        out=${out#running } display=${out%% *} ver=${out#* }
        echo "vivado-$name (Vivado $ver) already running on ajamian-dev:$display"
        xpra attach "ssh://ajamian-dev/$display" --ssh=ssh
        return
    fi
    if [[ $out == nodir ]]; then
        read -r "reply?~/research/projects/$name does not exist on ajamian-dev. Create it? [y/N] "
        [[ $reply == [yY]* ]] || return 1
        read -r "builddir?Build folder [/shared/build/$name]: " || return 1
        builddir=${${builddir:-/shared/build/$name}%/}
        if [[ ! $builddir =~ '^/[A-Za-z0-9._/-]+$' || $builddir =~ '(^|/)\.\.(/|$)' ]]; then
            echo "vivado@ajamian-dev: '$builddir' must be an absolute path (letters, digits, . _ - /, no ..)" >&2
            return 2
        fi

        # On the VM: the project's folders, the build link, a .gitignore and
        # scripts/create_project.tcl (Vivado runs it below).
        ssh ajamian-dev bash -s -- ${(qq)name} ${(qq)builddir} <<'EOF' || return 1
name=$1 build=$2
dir=~/research/projects/$name
mkdir -p "$dir"/rtl "$dir"/sim "$dir"/bd "$dir"/constr "$dir"/scripts "$build" || exit 1
ln -sfn "$build" "$dir/build" || exit 1
cat > "$dir/.gitignore" <<'X'
# Vivado project and build output (made by scripts/create_project.tcl)
build
.Xil/
*.jou
*.log
X
cat > "$dir/scripts/create_project.tcl" <<'X'
# Creates the Vivado project in build/ from the sources in this repo:
#   rtl/     design sources (.sv .v .vhd)
#   sim/     testbenches (.sv .v)
#   bd/      block designs, as exported with write_bd_tcl (.tcl)
#   constr/  constraints (.xdc)
# Rerun after adding files; -force replaces an existing project.
#   vivado -mode batch -source scripts/create_project.tcl -tclargs -force
# or, in the Vivado Tcl console: source scripts/create_project.tcl
set part xcv80-lsva4737-2MHP-e-S	;# the Alveo V80

set repo [file normalize [file join [file dirname [info script]] ..]]
set name [file tail $repo]
# Create the project at build/'s real location (build/ is a link): Vivado
# reopens projects at their real path, and paths stored relative to the
# link would break
set dir [file dirname [file normalize [file join $repo build _]]]
# Kept in a namespace of our own: Vivado's Tcl leaks globals (dir among
# them) while block designs are recreated below
namespace eval create_project_tcl {}
set create_project_tcl::xpr [file join $dir $name.xpr]
if {[file exists $create_project_tcl::xpr] && [lsearch $argv -force] < 0} {
    error "build/$name.xpr exists; rerun with -force to replace it"
}
create_project -force $name $dir -part $part

proc add_matching {fileset pattern} {
    set files [glob -nocomplain $pattern]
    if {[llength $files]} { add_files -norecurse -fileset $fileset $files }
}
foreach ext {sv v vhd} { add_matching sources_1 [file join $repo rtl *.$ext] }
foreach ext {sv v} { add_matching sim_1 [file join $repo sim *.$ext] }
add_matching constrs_1 [file join $repo constr *.xdc]
# Each block design script recreates its design; its HDL wrapper is
# generated and added as a design source
foreach script [glob -nocomplain [file join $repo bd *.tcl]] {
    source $script
    set bd [get_files [current_bd_design].bd]
    add_files -norecurse [make_wrapper -files $bd -top]
}
update_compile_order -fileset sources_1
puts "create_project: created $create_project_tcl::xpr"
X
# A git repo with the layout as its first commit; no remote. Git keeps no
# empty folders, so each gets a .gitkeep.
for d in rtl sim bd constr; do touch "$dir/$d/.gitkeep"; done
git -C "$dir" init -q -b main && git -C "$dir" add -A &&
    git -C "$dir" commit -q -m "Project layout from vivado@ajamian-dev" ||
    echo "git: no first commit in $dir (check git's user.name and user.email)" >&2
EOF
        echo "Created ~/research/projects/$name (build -> $builddir; git repo, no remote)"
        workdir=build tcl=scripts/create_project.tcl
    else
        xprs=(${(f)"$(print -r -- "$out" | sed -n 's/^xpr //p')"})
    fi
    if [[ -n $tcl ]]; then
        :
    elif (( ${#xprs} == 1 )); then
        xpr=$xprs[1]
    elif (( ${#xprs} > 1 )); then
        echo "Vivado projects under ~/research/projects/$name:"
        for i in {1..${#xprs}}; do echo "  $i) $xprs[i]"; done
        while :; do
            read -r "sel?Open which? [1-${#xprs}] " || return 1
            [[ $sel == <1-> ]] && (( sel <= ${#xprs} )) && break
        done
        xpr=$xprs[sel]
    else
        echo "No .xpr files under ~/research/projects/$name."
        read -r "workdir?Open Vivado in (relative to the project; Enter for the top level): " || return 1
    fi
    [[ -n $xpr ]] && workdir=${xpr:h}
    workdir=${${workdir:-.}%/}
    if [[ ! $workdir =~ '^[A-Za-z0-9._/-]+$' || $workdir == /* || $workdir =~ '(^|/)\.\.(/|$)' ]]; then
        echo "vivado@ajamian-dev: '$workdir' must be a path inside the project (letters, digits, . _ - /, no ..)" >&2
        return 2
    fi

    # On the VM: start the session in that folder and print "<display> <version>".
    # ssh joins its arguments into one remote command line, so an unquoted
    # empty $version would vanish and shift the rest; (qq) keeps it as ''.
    out=$(ssh ajamian-dev bash -s -- ${(qq)name} ${(qq)version} ${(qq)workdir} ${(qq)xpr:t} ${(qq)tcl} <<'EOF'
name=$1 want=$2 xpr=$4
dir=~/research/projects/$name
# A new project: Vivado runs its create_project.tcl instead of opening an .xpr
[ -n "$5" ] && xpr="-source $dir/$5"
[ "$3" = . ] || dir=$dir/$3
# Settings scripts for a version; the two layouts AMD has used on /shared.
settings() {
    local f
    for f in /shared/Xilinx/$1/Vivado/settings64.sh /shared/Xilinx/Vivado/$1/settings64.sh \
             /shared/Xilinx/Vitis_HLS/$1/settings64.sh; do
        [ -f "$f" ] && echo "$f"
    done
}
if [ -z "$want" ]; then
    want=$(ls -d /shared/Xilinx/[0-9]*.[0-9]*/Vivado /shared/Xilinx/Vivado/[0-9]*.[0-9]* 2>/dev/null \
        | grep -oE '[0-9]{4}\.[0-9]+' | sort -V | tail -1)
fi
src=$(settings "$want" | sed 's/.*/source &;/' | tr '\n' ' ')
if [ -z "$want" ] || [ -z "$src" ]; then
    echo "no Vivado ${want:-install} under /shared/Xilinx" >&2
    exit 1
fi
mkdir -p "$dir" || exit 1
used=$(xpra list 2>/dev/null | grep -oE ':[0-9]+' | tr -d :)
d=100
while printf '%s\n' "$used" | grep -qx "$d" || [ -e /tmp/.X11-unix/X$d ]; do d=$((d + 1)); done
xpra start :$d --daemon=yes --session-name=vivado-$name \
    --start="bash --noprofile --norc -c '$src cd $dir && vivado $xpr -log $dir/vivado.log -journal $dir/vivado.jou -tempDir $dir/.Xil'" >/dev/null 2>&1
for i in $(seq 20); do
    xpra list 2>/dev/null | grep -q "LIVE session at :$d\$" && { echo "$d $want"; exit 0; }
    sleep 0.5
done
echo "xpra session :$d did not come up" >&2
exit 1
EOF
    ) || return 1
    display=${out%% *} ver=${out#* }
    echo "vivado-$name (Vivado $ver) on ajamian-dev:$display${xpr:+, opening $xpr}${tcl:+, creating the project with $tcl}"
    xpra attach "ssh://ajamian-dev/$display" --ssh=ssh
}
